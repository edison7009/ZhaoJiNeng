4065.93406593407, "slug": "drug-repurposing-study-planner", "source": "community", "stars": 0, "tags": null, "updated_at": 1781060502053, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1776855180993, "description": "Scans the biomarker landscape of a disease area by biomarker type, clinical/research use case, evidence layer, validation status, and maturity level. Use this skill when a user wants a field-level biomarker evidence map rather than a generic literature summary. Always separate exploratory biomarkers from externally validated or clinically embedded biomarkers, and never imply clinical maturity without explicit evidence support.", "description_zh": "", "downloads": 93, "homepage": "https://api.skillhub.cn/user_c7479c7a/biomarker-landscape-scanner", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/a00e31c7-8d6a-4e65-84fc-16a177f95674.png", "installs": 1, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Biomarker Landscape Scanner", "ownerName": "user_c7479c7a", "score": 98936.17021276597, "slug": "biomarker-landscape-scanner", "source": "community", "stars": 0, "tags": null, "updated_at": 1780982922861, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1776853049784, "description": "Turns reviewer comments into structured, professional point-by-point responses linked to manuscript revisions, clarifications, rebuttals, and additional analyses.", "description_zh": "", "downloads": 93, "homepage": "https://api.skillhub.cn/user_c7479c7a/author-response-builder", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/a00e31c7-8d6a-4e65-84fc-16a177f95674.png", "insta