lyze.py --status\n\n# 手动凝练\npython3 scripts/condense.py --daily    # 每日\npython3 scripts/condense.py --weekly   # 每周\npython3 scripts/condense.py --monthly  # 每月\n🔧 依赖\nPython 3.7+\n无其他外部依赖", "downloads": 159, "homepage": "https://api.skillhub.cn/user_6b8a47e2/memory-palace-method", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/e089b3bb-5a99-41bc-8881-40980028b748.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "记忆宫殿记忆法", "ownerName": "user_6b8a47e2", "score": 3699.875981810666, "slug": "memory-palace-method", "source": "community", "stars": 1, "tags": null, "updated_at": 1781311532068, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1776484229193, "description": "海象剧本杀创作技能——剧本杀剧本生成专家。当用户需要创作剧本杀剧本、谋杀谜题游戏、LARP剧本、推理本、情感本、恐怖本、古风本、科幻本、搞笑本时触发。支持完整剧本生成（角色卡、线索、时间线、结局）或按模块单独生成。触发词包括：写剧本杀、剧本杀剧本、生成谋杀谜题、帮我写一本剧本杀、设计推理剧本、LARP剧本、设计角色卡、写侦探剧本、谋杀游戏剧本、创作情感本、恐怖剧本、古风悬疑剧本、科幻推理剧本、搞笑欢脱剧本、海象剧本杀创作。", "description_zh": "海象剧本杀创作技能——剧本杀剧本生成专家。当用户需要创作剧本杀剧本、谋杀谜题游戏、LARP剧本、推理本、情感本、恐怖本、古风本、科幻本、搞笑本时触发。支持完整剧本生成（角色卡、线索、时间线、结局）或按模块单独生成。触发词包括：写剧本杀、剧本杀剧本、生成谋杀谜题、帮我写一本剧本杀、设计推理剧本、LARP剧本、设计角色卡、写侦探剧本、谋杀游戏剧本、创作情感本、恐怖剧本、古风悬疑剧本、科幻推理剧本、搞笑欢脱剧本、海象剧本杀创作。", "downloads": 159, "homepage": "https://api.skillhub.cn/user_7290fc8d/walrus02", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/5a1e9830-80e4-4cbb-8d00-cee893ca9555.png", "installs": 9, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "海象剧本杀创作", "ownerName": "user_7290fc8d", "score": 84037.55868544601, "slug": "walrus02", "source": "community", "stars": 1, "tags": null, "updated_at": 1781261097673, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.1"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_