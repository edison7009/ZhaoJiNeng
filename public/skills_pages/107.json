l", "source": "clawhub", "stars": 2, "subCategories": [{"key": "design-video", "name": "视频处理"}], "tags": null, "updated_at": 1781672779504, "upstream_owner_login": "pauldelavallaz", "upstream_url": "https://clawhub.ai/pauldelavallaz/ugc-manual", "verified": false, "version": "1.0.2"}, {"category": "life-service", "claim_state": "unclaimed", "claimable": true, "claimed_user_handle": null, "created_at": 1772765662302, "description": "Privacy-first menstrual cycle tracking. Auto-learns periods, symptoms, and patterns.", "description_zh": "隐私优先的月经周期追踪，自动学习月经、症状和规律。", "downloads": 1355, "homepage": "https://api.skillhub.cn/ivangdavila/period", "iconUrl": null, "installs": 25, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Period Tracker", "ownerName": "ivangdavila", "score": 57859.809207797596, "slug": "period", "source": "clawhub", "stars": 2, "subCategories": [{"key": "life-health", "name": "健康管理"}], "tags": null, "updated_at": 1781672778550, "upstream_owner_login": "ivangdavila", "upstream_url": "https://clawhub.ai/ivangdavila/period", "verified": false, "version": "1.0.1"}, {"category": "knowledge-management", "claim_state": "unclaimed", "claimable": true, "claimed_user_handle": null, "created_at": 1772777833538, "description": "Helps users critically examine their beliefs by gently questioning potentially false or questionable claims on sensitive topics.", "description_zh": "通过温和质疑敏感话题中可能存在的虚假或可疑言论，帮助用户批判性地审视自身信念。", "downloads": 1352, "homepage": "https://api.skillhub.cn/asgraf/epistemic-guide", "iconUrl": null, "installs": 29, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Epistemic Guide", "ownerName": "asgraf", "score": 89517.6848874598, "slug": "epistemic-guide", "source": "clawhub", "stars": 2, "subCategories": [{"key": "knowledge-retrieval", "name": "信息检索"}, {"key": "knowledge-summary", "name": "摘要总结"}, {"key": "knowledge-doc-qa", "name": "文档问答"}], "tags": null, "updated_at": 1781672779084, "upstream_owner_