读这段文字\"\n\"生成播客音频\"\n\"用白桦的声音读一下\"\n\"TTS 这段内容\"\n\"换个声音\"", "downloads": 78, "homepage": "https://api.skillhub.cn/user_cd81d5a2/wenhao", "iconUrl": null, "installs": 0, "labels": {"requires_api_key": "true"}, "last_synced_at": null, "name": "MiMo TTS V2.5 语音生成", "ownerName": "user_cd81d5a2", "score": 100000, "slug": "wenhao", "source": "community", "stars": 0, "tags": null, "updated_at": 1781032478229, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1779587707633, "description": "", "description_zh": "", "downloads": 78, "homepage": "https://api.skillhub.cn/user_70c2f807/period-tracker-pro", "iconUrl": null, "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "经期管理", "ownerName": "user_70c2f807", "score": 98734.17721518988, "slug": "period-tracker-pro", "source": "community", "stars": 0, "tags": null, "updated_at": 1781032478205, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1779588815521, "description": "", "description_zh": "", "downloads": 78, "homepage": "https://api.skillhub.cn/user_70c2f807/team-performance-feedback", "iconUrl": null, "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "团队绩效反馈", "ownerName": "user_70c2f807", "score": 100000, "slug": "team-performance-feedback", "source": "community", "stars": 0, "tags": null, "updated_at": 1781032478008, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1779520944439, "description": "", "description_zh": "", "downloads": 78, "homepage": "https://api.skillhub.cn/user_5f0e7e4c/interview-info-c