ILL.md into your skills directory.", "downloads": 104, "homepage": "https://api.skillhub.cn/user_e8fae1af/skill-router-dynamic", "iconUrl": null, "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "skill-router-dynamic", "ownerName": "user_e8fae1af", "score": 55913.978494623654, "slug": "skill-router-dynamic", "source": "community", "stars": 0, "tags": null, "updated_at": 1781465093080, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "0.1.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1779587060766, "description": "", "description_zh": "", "downloads": 104, "homepage": "https://api.skillhub.cn/user_70c2f807/diet-record-analyzer", "iconUrl": null, "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "饮食记录分析", "ownerName": "user_70c2f807", "score": 53886.0103626943, "slug": "diet-record-analyzer", "source": "community", "stars": 0, "tags": null, "updated_at": 1781465093068, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1779587770109, "description": "", "description_zh": "", "downloads": 104, "homepage": "https://api.skillhub.cn/user_70c2f807/posture-checker", "iconUrl": null, "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "体态检测", "ownerName": "user_70c2f807", "score": 53886.0103626943, "slug": "posture-checker", "source": "community", "stars": 0, "tags": null, "updated_at": 1781465093058, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1779595812313, "description": "", "description_zh": "", "downloads": 104, "homepage": "https://api.skillhub.cn/user_70c2f807/