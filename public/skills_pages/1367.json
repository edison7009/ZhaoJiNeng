//cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/2d8152d9-7618-454e-9d87-2487f1b4457f.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Envoy Wrap", "ownerName": "user_922b1001", "score": 92307.69230769231, "slug": "envoy-wrap", "source": "community", "stars": 0, "subCategories": [{"key": "dev-script", "name": "脚本工具"}], "tags": null, "updated_at": 1781983104881, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "it-ops-security", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1781156777381, "description": "", "description_zh": "", "downloads": 48, "homepage": "https://api.skillhub.cn/user_922b1001/activemq-wrap", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/34a07e4e-fec8-4ce0-aaf8-a83e46546c2d.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Activemq Wrap", "ownerName": "user_922b1001", "score": 92307.69230769231, "slug": "activemq-wrap", "source": "community", "stars": 0, "subCategories": [{"key": "itops-server", "name": "服务器运维"}], "tags": null, "updated_at": 1781983104878, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "dev-programming", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1781157155535, "description": "", "description_zh": "", "downloads": 48, "homepage": "https://api.skillhub.cn/user_922b1001/foundry-wrap", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/62f73a9b-1aca-4f8e-921d-6102e258c768.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Foundry Wrap", "ownerName": "user_922b1001", "score": 92307.69230769231, "slug": "foundry-wrap", "source": "community", "stars": 0, "subCategories": [{"key": "dev-script", "name": "脚本工具"}], "tags": null, "updated_at": 1781983104875, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "data-analysis", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1780893190127, "description": "AI-powered plant growth stage auto-detection from periodic full-plant images via smart pot / greenhouse fixed cameras. Recognizes key phenological features—cotyledon emergence, true-leaf count, flower bud differentiation, blooming, fruit setting, fruit ripening—and identifies the current developmental stage (germination, seedling, vegetative, flowering, fruiting, ripening), enabling precision irrigation/fertilization/lighting control and personalized growing guidance. Scenarios: smart pots, home grow boxes, greenhouses, plant factories. | 通过智能花盆或温室内固定摄像头，定期拍摄植物整体图像，利用AI视觉分析技术识别子叶展开、真叶数量、花芽分化、开花、结果、果实成熟等关键物候特征，自动判定植物当前所处的生长发育阶段（如发芽期、幼苗期、生长期、开花期、结果期、成熟期）。有助于精准农业管理，实现自动化灌溉、施肥、光照调节，并为用户提供种植指导。应用场景：智能花盆、家庭种植机、温室大棚、植物工厂。", "description_zh": "AI-powered plant growth stage auto-detection from periodic full-plant images via smart pot / greenhouse fixed cameras. Recognizes key phenological features—cotyledon emergence, true-leaf count, flower bud differentiation, blooming, fruit setting, fruit ripening—and identifies the current developmental stage (germination, seedling, vegetative, flowering, fruiting, ripening), enabling precision irrigation/fertilization/lighting control and personalized growing guidance. Scenarios: smart pots, home grow boxes, greenhouses, plant factories. | 通过智能花盆或温室内固定摄像头，定期拍摄植物整体图像，利用AI视觉分析技术识别子叶展开、真叶数量、花芽分化、开花、结果、果实成熟等关键物候特征，自动判定植物当前所处的生长发育阶段（如发芽期、幼苗期、生长期、开花期、结果期、成熟期）。有助于精准农业管理，实现自动化灌溉、施肥、光照调节，并为用户提供种植指导。应用场景：智能花盆、家庭种植机、温室大棚、植物工厂。", "downloads": 48, "homepage": "https://api.skillhub.cn/user_bb47e3e3/plant-growth-stage-detection-analysis", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/0c9b068f-f22e-44e2-96fe-d2b6f5b43b07.png", "installs": 0, "labels": {"requires_api_key": "true"}, "last_synced_at": null, "name": "Plant Growth Stage Detection | 植物生长阶段自动判定", "ownerName": "user_bb47e3e3", "score": 92307.69230769231, "slug": "plant-growth-stage-detection-analysis", "source": "community", "stars": 0, "subCategories": [{"key": "data-visualization", "name": "数据可视化"}, {"key": "data-insight", "name": "数据洞察"}, {"key": "data-user-analysis", "name": "用户分析"}], "tags": null, "updated_at": 1781983104871, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "life-service", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1781018653837, "description": "AI-powered fruit ripeness grading for tomatoes / strawberries. From smart grow-boxes or mobile phone images, uses AI vision to detect fruit color (green / light green / orange / red / dark red), colored-area ratio, gloss, and relative fruit size (against a reference object), and outputs a ripeness grade (Mature-Green / Turning / Ripe / Over-Ripe) based on preset standards. Helps growers identify the optimal harvest window and ensures flavor and shelf quality. Scenarios: smart grow-boxes, greenhouses, home vegetable gardens, fruit & vegetable cooperatives. | 通过智能种植箱或手机拍摄的果实图像，利用AI视觉分析技术检测果实的颜色（绿/浅绿/橙/红/暗红）、着色面积比例、光泽度以及果实大小（相对于参照物），根据预设的成熟度分级标准输出等级（青熟期/转色期/成熟期/过熟期）。该技能帮助种植者确定最佳采收时机，保证果实口感和商品性。应用场景：智能种植箱、温室大棚、家庭菜园、果蔬合作社。", "description_zh": "AI-powered fruit ripeness grading for tomatoes / strawberries. From smart grow-boxes or mobile phone images, uses AI vision to detect fruit color (green / light green / orange / red / dark red), colored-area ratio, gloss, and relative fruit size (against a reference object), and outputs a ripeness grade (Mature-Green / Turning / Ripe / Over-Ripe) based on preset standards. Helps growers identify the optimal harvest window and ensures flavor and shelf quality. Scenarios: smart grow-boxes, greenhouses, home vegetable gardens, fruit & vegetable cooperatives. | 通过智能种植箱或手机拍摄的果实图像，利用AI视觉分析技术检测果实的颜色（绿/浅绿/橙/红/暗红）、着色面积比例、光泽度以及果实大小（相对于参照物），根据预设的成熟度分级标准输出等级（青熟期/转色期/成熟期/过熟期）。该技能帮助种植者确定最佳采收时机，保证果实口感和商品性。应用场景：智能种植箱、温室大棚、家庭菜园、果蔬合作社。", "downloads": 48, "homepage": "https://api.skillhub.cn/user_bb47e3e3/fruit-ripeness-grading-analysis", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/5a1e9830-80e4-4cbb-8d00-cee893ca9555.png", "installs": 0, "labels": {"requires_api_key": "true"}, "last_synced_at": null, "name": "Fruit Ripeness Grading | 番茄/草莓果实成熟度分级", "ownerName": "user_bb47e3e3", "score": 92307.69230769231, "slug": "fruit-ripeness-grading-analysis", "source": "community", "stars": 0, "subCategories": [{"key": "life-health", "name": "健康管理"}], "tags": null, "updated_at": 1781983104868, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "dev-programming", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1781156921596, "description": "", "description_zh": "", "downloads": 48, "homepage": "https://api.skillhub.cn/user_922b1001/charset-normalizer-wrap", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/c5e5faab-b8e1-489d-a489-8b56ffc52c07.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "Charset Normalizer Wrap", "ownerName": "user_922b1001", "score": 92307.69230769231, "slug": "charset-normalizer-wrap", "source": "community", "stars": 0, "subCategories": [{"key": "dev-script", "name": "脚本工具"}], "tags": null, "updated_at": 1781983104867, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "ai-agent", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1781241810919, "description": "", "description_zh": "", "downloads": 48, "homepage": "https://api.skillhub.cn/user_922b1001/airflow", "iconU