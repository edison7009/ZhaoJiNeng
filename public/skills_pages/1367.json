ream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "ai-agent", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1780808369285, "description": "通用 Webhook 通知工具，支持钉钉、企业微信、飞书、Slack、Discord、Telegram。自动识别平台，统一接口，内置模板系统和重试机制。", "description_zh": "通用 Webhook 通知工具，支持钉钉、企业微信、飞书、Slack、Discord、Telegram。自动识别平台，内置模板系统和重试机制。", "downloads": 48, "homepage": "https://api.skillhub.cn/user_15292d5a/yjkj-webhook-notify", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/7422abc7-fa86-4505-a723-0575c56e7a2d.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "webhook-notify", "ownerName": "user_15292d5a", "score": 30967.74193548387, "slug": "yjkj-webhook-notify", "source": "community", "stars": 0, "subCategories": [{"key": "agent-tool-use", "name": "工具调用"}], "tags": null, "updated_at": 1781943296652, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "2.0.0"}, {"category": "data-analysis", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1780489382296, "description": "用于快手数据助手、快手热榜、快手内容研究、作品研究、作品详情、评论分析、评论回复分析、达人数据和达人作品。覆盖 Kuaishou / Kwai short-video research，来自 SocialDataX 社媒数据助手。", "description_zh": "用于快手数据助手、快手热榜、快手内容研究、作品研究、作品详情、评论分析、评论回复分析、达人数据和达人作品。覆盖 Kuaishou / Kwai short-video research，来自 SocialDataX 社媒数据助手。", "downloads": 48, "homepage": "https://api.skillhub.cn/user_825d9e7e/socialdatax-kuaishou", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/c5e5faab-b8e1-489d-a489-8b56ffc52c07.png", "installs": 0, "labels": {"requires_api_key": "true"}, "last_synced_at": null, "name": "快手数据助手 SocialDataX", "ownerName": "user_825d9e7e", "score": 12151.898734177215, "slug": "socialdatax-kuaishou", "source": "community", "stars": 0, "subCategories": [{"key": "data-insight", "name": "数据洞察"}, {"key": "data-competitor", "name": "竞品分析"}, {"key": "data-user-analysis", "name": "用户分析"}], "tags": null, "updated_at": 1781922417562, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}, {"category": "content-creation", "claim_state": "unclaimed", "claimable": false, "claimed_user_handle": null, "created_at": 1780721393025, "description": "AI配音生成助手 — 多音色+情感控制+多语言，为视频/播客/广告生成专业级配音方案", "description_zh": "AI配音生成助手 — 多音色+情感控制+多语言，为视频/播客/广告生成专业级配音方案\n熟练掌握各类AI配音生成工具的操作与应用，能够根据不同场景需求完成语音合成创作：精通音色筛选与参数调试，可针对短视频解说、有声读物、广告宣传片、教育课件等不同内容调性，匹配适配的风格音色；掌握声音克隆技术操作流程，可通过1分钟以内的音频样本复刻专属声线，实现角色语音的一致性；擅长文本预处理与韵律调整，能通过分段生成、标点优化、插入停顿换气标记等方式提升语音自然度，支持多语种、多方言语音转换，可完成多角色批量配音与字幕同步导出，能在3分钟内完成千字文本的配音生成与导出，满足内容创作者快速量产需求。\n\n产品功能技能描述（推广/介绍版）\n依托深度学习语音合成算法，具备多元化专业配音生成能力：\n\n‌海量音色库适配‌：覆盖500+高拟真AI音色，包含男女声、特色网红音、方言、多国外语，细分影视解说、小说推文、综艺二创、商业广告等场景专属音色，精准匹配内容调性\n‌个性化定制能力‌：支持专属音色克隆，仅需少量音频样本即可复刻目标声线，存储后可随时调用；支持语速、音量、语调自由调节，可插入停顿、换气标记调整韵律，满足个性化语音需求\n‌高效批量处理‌：支持长文本分段合成、多角色同步配音，短文本即时生成，长文本最快3分钟输出，支持多格式高清音频导出，可搭配字幕导出功能，适配各类视频剪辑流程\n‌创意拓展功能‌：支持AI语音唱歌、背景音乐添加、多音字智能纠错、视频文案提取等增值功能，一站式满足声音创作全需求。", "downloads": 48, "homepage": "https://api.skillhub.cn/user_a020b36c/ai-voice-generator-new", "iconUrl": "https://cloudcache.tencent-cloud.com/qcloud/ui/static/other_external_resource/7f79eb60-b8d8-4d8e-9b79-6ace0de1ff17.png", "installs": 0, "labels": {"requires_api_key": "false"}, "last_synced_at": null, "name": "AI配音生成器", "ownerName": "user_a020b36c", "score": 25531.91489361702, "slug": "ai-voice-generator-new", "source": "community", "stars": 0, "subCategories": [{"key": "content-social-media", "name": "自媒体运营"}, {"key": "content-short-video-script", "name": "短视频脚本"}], "tags": null, "updated_at": 1781859418603, "upstream_owner_login": null, "upstream_url": null, "verified": false, "version": "1.0.0"}]}